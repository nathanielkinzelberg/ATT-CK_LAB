# ATT&CK-Pi Lab — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# API token used by the controller to authenticate with the agent.
# Generate a strong random value: python3 -c "import secrets; print(secrets.token_hex(32))"
ATTACK_PI_API_TOKEN=replace-with-a-strong-random-token

# Agent host and port (used by the controller)
AGENT_HOST=192.168.1.50
AGENT_PORT=8000
